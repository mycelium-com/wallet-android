import com.mycelium.wapi.wallet.coins.Value;
import java.math.BigInteger;
import java.util.UUID;
import kotlin.Boolean;

-- Creates table for transactions

CREATE TABLE IF NOT EXISTS EthAccountBacking (
    txid TEXT NOT NULL,
    uuid TEXT AS UUID NOT NULL,
    fromAddress TEXT NOT NULL,
    toAddress TEXT NOT NULL,
    nonce TEXT AS BigInteger,
    gasLimit TEXT AS BigInteger DEFAULT 21000 NOT NULL,
    gasUsed TEXT AS BigInteger DEFAULT 21000 NOT NULL,
    gasPrice TEXT AS BigInteger,
    success INTEGER AS Boolean NOT NULL DEFAULT 1,
    internalValue TEXT AS Value,
    hasTokenTransfers INTEGER AS Boolean NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'PENDING',
    PRIMARY KEY (txid, uuid),
    FOREIGN KEY (txid, uuid)
            REFERENCES AccountBacking (txid, uuid)
            ON DELETE CASCADE
);


-- ORDER BY note: pending txs are stored with blockNumber = Int.MAX_VALUE
-- (2147483647) so they sort to the top. Once a tx flips to a terminal
-- status (CANCELED / REPLACED / DROPPED) it must NOT keep that top slot —
-- mark*Status updates the row with the replacement's blockNumber going
-- forward, but legacy rows can still carry MAX_VALUE. Clamp to 0 here so
-- the list sorts by time even if migration data is stale.

selectTransactionSummaries:
SELECT eb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
    eb.fromAddress, eb.toAddress, eb.nonce, eb.gasLimit, eb.gasUsed, eb.gasPrice, eb.success, eb.internalValue, eb.hasTokenTransfers, eb.status
FROM EthAccountBacking AS eb
    INNER JOIN AccountBacking AS b
    ON eb.uuid = b.uuid AND eb.txid = b.txid
        WHERE eb.uuid = (:uuid)
        ORDER BY (CASE WHEN eb.status = 'PENDING' THEN b.blockNumber
                       WHEN b.blockNumber = 2147483647 THEN 0
                       ELSE b.blockNumber END) DESC,
                 b.timestamp DESC
        LIMIT (:limit) OFFSET (:offset);


-- Selects transactions since time in seconds

selectTransactionSummariesSince:
SELECT eb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
    eb.fromAddress, eb.toAddress, eb.nonce, eb.gasLimit, eb.gasUsed, eb.gasPrice, eb.success, eb.internalValue, eb.hasTokenTransfers, eb.status
FROM EthAccountBacking AS eb
    INNER JOIN AccountBacking AS b
    ON eb.uuid = b.uuid AND eb.txid = b.txid
        WHERE eb.uuid = (:uuid) AND b.timestamp > (:timestamp)
        ORDER BY (CASE WHEN eb.status = 'PENDING' THEN b.blockNumber
                       WHEN b.blockNumber = 2147483647 THEN 0
                       ELSE b.blockNumber END) DESC,
                 b.timestamp DESC;

selectTransactionSummaryById:
SELECT eb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
     eb.fromAddress, eb.toAddress, eb.nonce, eb.gasLimit, eb.gasUsed, eb.gasPrice, eb.success, eb.internalValue, eb.hasTokenTransfers, eb.status
FROM EthAccountBacking AS eb
    INNER JOIN AccountBacking AS b
    ON eb.uuid = b.uuid AND eb.txid = b.txid
        WHERE eb.uuid = (?) AND eb.txid = (?);

selectUnconfirmedTransactions:
SELECT eb.txid, b.currency, b.blockNumber, b.timestamp,
           b.value, b.fee, b.confirmations, eb.fromAddress, eb.toAddress, eb.nonce, eb.gasLimit, eb.gasUsed, eb.gasPrice, eb.hasTokenTransfers, eb.status
FROM EthAccountBacking AS eb
    INNER JOIN AccountBacking AS b
    ON eb.uuid = b.uuid AND eb.txid = b.txid
        WHERE eb.uuid = (:uuid) AND b.confirmations = 0
        ORDER BY (CASE WHEN eb.status = 'PENDING' THEN b.blockNumber
                       WHEN b.blockNumber = 2147483647 THEN 0
                       ELSE b.blockNumber END) DESC,
                 b.timestamp DESC;

insertTransaction:
INSERT OR REPLACE INTO EthAccountBacking(txid, uuid, fromAddress, toAddress, nonce, gasLimit, gasPrice,
                                         success, internalValue, hasTokenTransfers, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateGasUsed:
UPDATE EthAccountBacking
SET gasUsed = (?)
WHERE uuid = (?) AND txid = (?);

updateNonce:
UPDATE EthAccountBacking
SET nonce = (?)
WHERE uuid = (?) AND txid = (?);

updateStatus:
UPDATE EthAccountBacking
SET status = (?)
WHERE uuid = (?) AND txid = (?);

selectStatus:
SELECT status FROM EthAccountBacking WHERE uuid = (?) AND txid = (?);

deleteTransaction:
DELETE FROM EthAccountBacking
WHERE uuid = (?) AND txid = (?);
