import java.math.BigInteger;
import java.util.UUID;
import kotlin.Boolean;

-- TRON transactions (TRX transfers, TRC20 transfers and other contract types)

CREATE TABLE IF NOT EXISTS TronAccountBacking (
    txid TEXT NOT NULL,
    uuid TEXT AS UUID NOT NULL,
    fromAddress TEXT NOT NULL,
    toAddress TEXT NOT NULL,
    bandwidth TEXT AS BigInteger DEFAULT 268 NOT NULL,
    energy TEXT AS BigInteger DEFAULT 0 NOT NULL,
    feeLimit TEXT AS BigInteger DEFAULT 0 NOT NULL,
    success INTEGER AS Boolean NOT NULL DEFAULT 1,
    hasTokenTransfers INTEGER AS Boolean NOT NULL DEFAULT 0,
    tronTxType TEXT NOT NULL DEFAULT 'TRX_TRANSFER',
    PRIMARY KEY (txid, uuid),
    FOREIGN KEY (txid, uuid)
            REFERENCES AccountBacking (txid, uuid)
            ON DELETE CASCADE
);

selectTransactionSummaries:
SELECT tb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
    tb.fromAddress, tb.toAddress, tb.bandwidth, tb.energy, tb.feeLimit, tb.success, tb.hasTokenTransfers, tb.tronTxType
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid) ORDER BY b.blockNumber DESC, b.timestamp DESC
        LIMIT (:limit) OFFSET (:offset);

-- Same as selectTransactionSummaries, but only value transfers (TRX / TRC20): the history's
-- default view hides staking, resource delegation, votes, contract calls and other operations.
-- Exception: on the TRX account a TRC20 send is a contract call that burns the TRX fee; it stays
-- visible when it targets a known token contract (:tokenContracts) or is stored as a TRC20
-- transfer by one of the wallet's token accounts — unless it burned nothing (paid with staked
-- energy/bandwidth), which would only render as a "0 TRX" row.
-- Address-poisoning dust is hidden too: zero-value transfers (spoofed `transferFrom(victim, x, 0)`
-- shows up as "outgoing") and incoming transfers below :dustThreshold (in base units, e.g.
-- 0.000001 TRX from a look-alike address). The amount is parsed from the stored Value JSON without
-- json_extract, which old Android SQLite builds (minSdk 24) lack.
selectTransferSummaries:
SELECT tb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
    tb.fromAddress, tb.toAddress, tb.bandwidth, tb.energy, tb.feeLimit, tb.success, tb.hasTokenTransfers, tb.tronTxType
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid)
          AND ((tb.tronTxType IN ('TRX_TRANSFER', 'TRC20_TRANSFER')
                AND CAST(rtrim(substr(b.value, instr(b.value, '"Value":') + 8), '}') AS REAL) > 0
                AND (tb.toAddress != (:ownerAddress) OR tb.fromAddress = (:ownerAddress)
                     OR CAST(rtrim(substr(b.value, instr(b.value, '"Value":') + 8), '}') AS REAL) >= (:dustThreshold)))
               OR (tb.tronTxType = 'CONTRACT_CALL'
                   AND (CAST(rtrim(substr(b.fee, instr(b.fee, '"Value":') + 8), '}') AS REAL) > 0
                        OR CAST(rtrim(substr(b.value, instr(b.value, '"Value":') + 8), '}') AS REAL) > 0)
                   AND (tb.toAddress IN :tokenContracts
                        OR EXISTS (SELECT 1 FROM TronAccountBacking AS t2
                                   WHERE t2.txid = tb.txid AND t2.tronTxType = 'TRC20_TRANSFER'))))
        ORDER BY b.blockNumber DESC, b.timestamp DESC
        LIMIT (:limit) OFFSET (:offset);

-- Selects transactions since time in seconds
selectTransactionSummariesSince:
SELECT tb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
    tb.fromAddress, tb.toAddress, tb.bandwidth, tb.energy, tb.feeLimit, tb.success, tb.hasTokenTransfers, tb.tronTxType
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid) AND b.timestamp > (:timestamp)
        ORDER BY b.blockNumber DESC, b.timestamp DESC;

selectTransactionSummaryById:
SELECT tb.txid, b.currency, b.blockNumber, b.timestamp, b.value, b.fee, b.confirmations,
     tb.fromAddress, tb.toAddress, tb.bandwidth, tb.energy, tb.feeLimit, tb.success, tb.hasTokenTransfers, tb.tronTxType
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (?) AND tb.txid = (?);

-- "Unconfirmed" = not yet in a block: locally broadcast txs are stored with
-- blockNumber = 2147483647 (Int.MAX_VALUE), remote txs not yet indexed with 0.
selectUnconfirmedTransactions:
SELECT tb.txid, b.currency, b.blockNumber, b.timestamp,
           b.value, b.fee, b.confirmations, tb.fromAddress, tb.toAddress, tb.bandwidth, tb.energy, tb.feeLimit, tb.success, tb.hasTokenTransfers, tb.tronTxType
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid) AND b.confirmations = 0 AND (b.blockNumber = 0 OR b.blockNumber = 2147483647)
        ORDER BY b.blockNumber DESC, b.timestamp DESC;

-- txid -> blockNumber for txs already included in a block (excludes the local pending marker)
selectConfirmedTxBlocks:
SELECT tb.txid, b.blockNumber
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid) AND b.blockNumber > 0 AND b.blockNumber < 2147483647;

-- Newest confirmed tx timestamp (seconds); 0 when the account has no confirmed history
selectMaxConfirmedTimestamp:
SELECT COALESCE(MAX(b.timestamp), 0)
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid) AND b.blockNumber > 0 AND b.blockNumber < 2147483647;

insertTransaction:
INSERT OR REPLACE INTO TronAccountBacking(txid, uuid, fromAddress, toAddress, bandwidth, energy, feeLimit,
                                         success, hasTokenTransfers, tronTxType)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSuccess:
UPDATE TronAccountBacking
SET success = (?)
WHERE uuid = (?) AND txid = (?);

-- What a mined tx really consumed (from its receipt), replacing the estimate stored at broadcast
updateResources:
UPDATE TronAccountBacking
SET energy = (?), bandwidth = (?)
WHERE uuid = (?) AND txid = (?);

selectConfirmedTxidsWithEnergy:
SELECT tb.txid
FROM TronAccountBacking AS tb
    INNER JOIN AccountBacking AS b
    ON tb.uuid = b.uuid AND tb.txid = b.txid
        WHERE tb.uuid = (:uuid) AND tb.energy = (:energy) AND b.blockNumber > 0 AND b.blockNumber < 2147483647;

deleteTransaction:
DELETE FROM TronAccountBacking
WHERE uuid = (?) AND txid = (?);

-- Links energy service fee transactions to their parent (main) transactions.
-- Stored separately so that syncTransactions (INSERT OR REPLACE) does not overwrite the flag.
CREATE TABLE IF NOT EXISTS EnergyServiceFeeLink (
    feeTxId TEXT NOT NULL,
    mainTxId TEXT NOT NULL,
    uuid TEXT AS UUID NOT NULL,
    PRIMARY KEY (feeTxId, uuid)
);

insertFeeLink:
INSERT OR IGNORE INTO EnergyServiceFeeLink(feeTxId, mainTxId, uuid) VALUES (?, ?, ?);

selectFeeLinks:
SELECT feeTxId, mainTxId FROM EnergyServiceFeeLink WHERE uuid = (:uuid);

deleteFeeLink:
DELETE FROM EnergyServiceFeeLink WHERE feeTxId = (?) AND uuid = (?);

-- Every value of a TRON row is tagged with the row's `currency` (TRX for both TRX and TRC20
-- accounts): the value adapter resolves tags through COINS only, and a TRC20 token is a runtime
-- object that is not in it. A row tagged with the token throws on every read of the history —
-- that is, on every sync and on startup. Builds before the tagging rule wrote such rows for
-- energy-service transfers; migration 17 repaired what existed at upgrade time, but a build that
-- carried the migration and not the write fix kept adding them afterwards, so the account repairs
-- its own rows each time it is opened. The amount survives the retag; the fee becomes zero TRX,
-- which is what the row would have been written with (the token fee is a transfer of its own,
-- linked through EnergyServiceFeeLink).
repairValueTags:
UPDATE AccountBacking
SET value = CASE WHEN value LIKE '%"Asset":"' || currency || '"%' THEN value
                 ELSE '{"Asset":"' || currency || '","Value":'
                      || rtrim(substr(value, instr(value, '"Value":') + 8), '}') || '}' END,
    fee = CASE WHEN fee LIKE '%"Asset":"' || currency || '"%' THEN fee
               ELSE '{"Asset":"' || currency || '","Value":0}' END
WHERE uuid = (:uuid)
  AND (value NOT LIKE '%"Asset":"' || currency || '"%'
       OR fee NOT LIKE '%"Asset":"' || currency || '"%');
